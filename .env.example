# Desktop renderer: public API origin only. Use HTTPS outside local development.
VITE_API_ORIGIN=http://127.0.0.1:3001
# Server only:
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
MIGRATION_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AUTH_ISSUER=https://identity.example.edu/
AUTH_AUDIENCE=ju-admission-api
AUTH_JWKS_URL=https://identity.example.edu/.well-known/jwks.json
HOST=127.0.0.1
PORT=3001
# Local development only; never set in production.
DEV_STAFF_TOKEN=
# Server only: Azure AI Document Intelligence (prebuilt-layout) for transcript OCR.
# Keep the key on the API server; never add it to VITE_* variables or the desktop build.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=

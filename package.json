{
  "name": "ju-admission-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jahangirnagar University GCE admission eligibility desktop application",
  "main": "apps/desktop/electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file=.env --watch --import tsx apps/api/src/server.ts",
    "dev:desktop": "electron .",
    "build": "tsc --noEmit && vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "db:migrate": "node --env-file=.env --import tsx apps/api/src/migrate.ts",
    "test": "vitest run",
    "package:win": "npm run build && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@tanstack/react-query": "^5.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-native-web": "^0.19.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "edu.ju.admission.checker",
    "productName": "JU Admission Checker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "apps/desktop/electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
